# Copie este arquivo para ".env" e preencha com seus valores reais.
# O arquivo ".env" NUNCA deve ser commitado (já está no .gitignore).

# --- Banco de dados (PostgreSQL via Docker Compose) ---
POSTGRES_USER=conecta
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=conecta
POSTGRES_PORT=5432

# String de conexão usada pelo ETL e pela API
DATABASE_URL=postgresql://conecta:troque_esta_senha@localhost:5432/conecta

# --- API (FastAPI) ---
# Domínios autorizados a chamar a API (separados por vírgula)
CORS_ORIGINS=http://localhost:5173

# --- Front-end (Vite) ---
# Endereço da API consumida pelo front-end
VITE_API_URL=http://localhost:8000
